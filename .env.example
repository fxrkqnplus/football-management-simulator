# Football Management Simulator — ortam değişkenleri örneği
#
# Kopyalayıp doldurun:   cp .env.example .env
# .env ASLA commit edilmez (.gitignore). Repo public.
#
# Şema ve doğrulama: packages/shared/src/env.ts
# Eksik veya geçersiz bir değerle uygulama AÇILMAZ ve hangi değişkenin neden
# gerektiğini söyleyen Türkçe bir hata basar.

# ─── Uygulama ────────────────────────────────────────────────────────────────
NODE_ENV=development
# Alt yol TEK KAYNAK. Vite base, Router basename, API ön eki, çerez path,
# servis çalışanı kapsamı ve PWA manifest bu değerden türetilir (K6).
PUBLIC_BASE_PATH=/fms
PUBLIC_URL=http://localhost:3000/fms
API_PORT=3001
WEB_PORT=3000

# ─── Veritabanı (ZORUNLU) ────────────────────────────────────────────────────
DATABASE_URL=postgresql://fms:password@localhost:5432/fms
REDIS_URL=redis://localhost:6379

# ─── Kimlik ──────────────────────────────────────────────────────────────────
# En az 32 karakter. Üretmek için: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# İlk admin hesabı için tek kullanımlık
SETUP_TOKEN=
# Bakım modu kaçış anahtarı
EMERGENCY_ADMIN_TOKEN=

# ─── E-posta ─────────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@fxrkqn.org

# ─── Cloudflare ──────────────────────────────────────────────────────────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fms-assets
R2_PUBLIC_URL=

# ─── Sunucu kipi ─────────────────────────────────────────────────────────────
# private | public | maintenance
# private: kayıt açık ama yalnızca izin listesindekiler oynar (varsayılan).
# public'e geçmek bilinçli bir karardır — KVKK metinleri o zaman devreye girer.
SERVER_MODE=private

# ─── Simülasyon ──────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=1
# SimulationPolicy (kayıt başına, kullanıcıya açık): balanced | full
#   balanced → kullanıcının maçı EngineTier=full, kendi ligi medium,
#              diğer ülkeler statistical
#   full     → tüm maçlar EngineTier=full
# EngineTier (maç başına, motor içi) ile karıştırmayın.
DEFAULT_SIM_POLICY=balanced
TURN_LOCK_TTL_SECONDS=300

# ─── Gözlem ──────────────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info

# ─── Veri ────────────────────────────────────────────────────────────────────
# full  → gerçek armalar, portreler, isimler, formalar (varsayılan)
# clean → tümüyle prosedürel
DATA_MODE=full
# /data/packs/ altındaki paket klasörü. BOŞ BIRAKILABİLİR — sağlayıcı zinciri
# API/Wikidata/prosedürel basamaklarına düşer, açılışta uyarı basılır.
ACTIVE_PACK=
FOOTBALL_DATA_API_KEY=
API_FOOTBALL_KEY=

# real | stylized | procedural   (sunucu varsayılanı, kullanıcı ayarı ezer)
# stylized: gerçek fotoğraflar ve üretilmiş portreler aynı işlemden geçer,
#           yan yana ayırt edilemez. 5. sezondaki tutarsızlığı çözer.
PORTRAIT_STYLE=stylized
