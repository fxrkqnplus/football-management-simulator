{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/bash-text-guard/index.mjs\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(node *)",
      "Workflow"
    ],
    "deny": ["Bash(git push --force*)", "Read(./.env)"]
  },
  "workflowSizeGuideline": "medium"
}
