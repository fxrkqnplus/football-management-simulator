# BAĞIMLILIKLARIN `engines` alanı zorlanır: uyumsuz bir paket kurulmaz.
# DİKKAT: Bu ayar kök projenin KENDİ `engines.node` alanını zorlamaz — pnpm orada
# yalnızca [WARN] basıp devam eder. Runtime kapısı bu yüzden `preinstall` betiğiyle
# kurulur: scripts/check-node-version.mjs (tek kaynak: .nvmrc).
engine-strict=true

# Peer uyumsuzluğu uyarı değil HATA olsun.
# Gerekçe: typescript-eslint peer aralığı `typescript >=4.8.4 <6.1.0` (ADR-0003).
# Bu sınır sessizce aşılırsa lint zinciri çöker ve fark etmek günler alır.
# Belirli bir paket için istisna gerekirse pnpm.peerDependencyRules.allowedVersions
# kullanılır — bu ayar global olarak KAPATILMAZ.
strict-peer-dependencies=true
