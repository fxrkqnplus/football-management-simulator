{
  // Derleme yapılandırması: yalnızca `src/` altındaki ürün kodu `dist/`e girer.
  // Tip denetimi (tsconfig.json) DAHA GENİŞ bir küme kapsar — `drizzle.config.ts`
  // ve `integration/` de denetlenir ama emit EDİLMEZ.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // rootDir/outDir burada, tsconfig.json'da değil (gerekçe orada yazılı).
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false
  },
  "include": ["src/**/*"],
  "exclude": [
    "dist",
    "node_modules",
    "integration",
    "drizzle.config.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.test.mts",
    "src/**/*.test.cts"
  ]
}
